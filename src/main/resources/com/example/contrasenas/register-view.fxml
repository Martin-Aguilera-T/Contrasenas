<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<ScrollPane fitToWidth="true" styleClass="scroll-pane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.contrasenas.controller.RegisterController">

    <!-- Enlace a la hoja de estilos externa -->
    <stylesheets>
        <URL value="@styles.css" />
    </stylesheets>

    <content>
        <VBox alignment="TOP_CENTER" spacing="15.0" styleClass="root-container">
            <children>
                <!-- Título y Subtítulo -->
                <Label styleClass="title-label" text="Registro de Usuarios" />
                <Label styleClass="subtitle-label" text="Complete la información para registrar o modificar un usuario" />

                <!-- Formulario en Cuadrícula -->
                <GridPane hgap="12" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" />
                        <ColumnConstraints percentWidth="50" />
                    </columnConstraints>

                    <children>
                        <TextField fx:id="txtUserId" promptText="ID de Usuario" styleClass="text-field" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <PasswordField fx:id="txtPassword" promptText="Contraseña" styleClass="password-field" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <TextField fx:id="txtFirstName" promptText="Nombre(s)" styleClass="text-field" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <TextField fx:id="txtLastName" promptText="Apellido(s)" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <TextField fx:id="txtEmail" promptText="Correo Electrónico" styleClass="text-field" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <ComboBox fx:id="cmbRole" prefWidth="300" promptText="Seleccionar Rol" styleClass="combo-box" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <TextField fx:id="txtCurp" promptText="CURP" styleClass="text-field" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                        <TextField fx:id="txtRfc" promptText="RFC" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <TextField fx:id="txtSpecialty" promptText="Especialidad / Puesto" styleClass="text-field" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                        <ComboBox fx:id="cmbStatus" prefWidth="300" promptText="Estado del Usuario" styleClass="combo-box" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                        <TextField fx:id="txtPhone" promptText="Teléfono (Encriptado AES)" styleClass="text-field" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                        <TextField fx:id="txtAddress" promptText="Dirección (Encriptada AES)" styleClass="text-field" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                        <TextField fx:id="txtSalary" promptText="Sueldo (Encriptado AES)" styleClass="text-field" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                        <TextArea fx:id="txtNotes" prefHeight="65" promptText="Notas u Observaciones..." styleClass="text-area" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                    </children>
                </GridPane>

                <!-- Botón de Registro -->
                <Button onAction="#handleRegistrar" prefWidth="250.0" styleClass="button-primary" text="Guardar Registro" />

                <!-- Label para Mensajes / Validaciones -->
                <Label fx:id="lblMensaje" styleClass="subtitle-label" />
            </children>
        </VBox>
    </content>
</ScrollPane>