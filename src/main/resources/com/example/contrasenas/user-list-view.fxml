<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.net.URL?>

<VBox spacing="15.0" styleClass="root-container" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.contrasenas.controller.UserListController">

    <stylesheets>
        <URL value="@styles.css" />
    </stylesheets>

    <children>
        <Label styleClass="title-label" text="Lista de Usuarios Registrados" />

        <TableView fx:id="tblUsuarios" prefHeight="450.0" prefWidth="850.0" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colUserId" prefWidth="90.0" text="ID USUARIO" />
                <TableColumn fx:id="colFirstName" prefWidth="110.0" text="NOMBRE" />
                <TableColumn fx:id="colLastName" prefWidth="110.0" text="APELLIDOS" />
                <TableColumn fx:id="colEmail" prefWidth="150.0" text="CORREO" />
                <TableColumn fx:id="colStatus" prefWidth="85.0" text="ESTADO" />
                <TableColumn fx:id="colRole" prefWidth="85.0" text="ROL" />
                <TableColumn fx:id="colDate" prefWidth="110.0" text="FECHA REGISTRO" />
                <TableColumn fx:id="colPhone" prefWidth="110.0" text="TELÉFONO" />
                <TableColumn fx:id="colAddress" prefWidth="130.0" text="DIRECCIÓN" />
                <TableColumn fx:id="colSalary" prefWidth="90.0" text="SUELDO" />
            </columns>
        </TableView>
    </children>
</VBox>