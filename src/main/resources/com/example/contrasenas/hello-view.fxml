<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #2b3e50; -fx-padding: 30;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.contrasenas.controller.LoginController">
    <children>
        <Label text="Login to our site" textFill="WHITE">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>
        <Label text="Enter username and password to log on" textFill="#b0bec5" />

        <TextField fx:id="txtUsername" promptText="Username..." style="-fx-pref-height: 35; -fx-background-radius: 5;" />
        <PasswordField fx:id="txtPassword" promptText="Password..." style="-fx-pref-height: 35; -fx-background-radius: 5;" />

        <Button fx:id="btnLogin" onAction="#handleLogin" prefWidth="250.0" style="-fx-background-color: #00a8cc; -fx-text-fill: white; -fx-font-weight: bold; -fx-pref-height: 40; -fx-cursor: hand;" text="Sign in!" />

        <Label fx:id="lblError" textFill="#ff5252" />
    </children>
</VBox>