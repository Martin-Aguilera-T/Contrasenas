<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.contrasenas.controller.MainMenuController">

    <stylesheets>
        <URL value="@styles.css" />
    </stylesheets>

    <top>
        <MenuBar styleClass="menu-bar" BorderPane.alignment="CENTER">
            <menus>
                <Menu text="Opciones">
                    <items>
                        <MenuItem onAction="#handleVerUsuarios" text="Ver usuarios" />
                        <MenuItem fx:id="menuItemEditar" onAction="#handleAgregarUsuario" text="Editar usuarios" />
                        <SeparatorMenuItem />
                        <MenuItem onAction="#handleSalir" text="Salir" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>

    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">
            <VBox alignment="CENTER" spacing="15.0">
                <Label styleClass="title-label" text="Ferretería Calderón" />

                <ImageView fitHeight="150.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="https://images.seeklogo.com/logo-png/40/2/cruz-azul-f-c-logo-png_seeklogo-405542.png" />
                    </image>
                </ImageView>
            </VBox>
        </StackPane>
    </center>
</BorderPane>