<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.contrasenas.controller.MainMenuController">
    <top>
        <MenuBar BorderPane.alignment="CENTER">
            <menus>
                <Menu text="Opciones">
                    <items>
                        <MenuItem onAction="#handleVerUsuarios" text="Ver usuarios" />
                        <MenuItem fx:id="menuItemEditar" onAction="#handleAgregarUsuario" text="Editar usuarios (Agregar)" />
                        <SeparatorMenuItem />
                        <MenuItem onAction="#handleSalir" text="Salir" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>
    <center>
        <StackPane fx:id="contentArea" style="-fx-padding: 20; -fx-background-color: #f4f4f4;">
            <Label text="Bienvenido al Sistema de Gestión de Usuarios" textFill="#333333">
                <font>
                    <Font size="18.0" />
                </font>
            </Label>
        </StackPane>
    </center>
</BorderPane>